---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import CoverImage from "../components/CoverImage.astro";
import CarteArticle from "../components/CarteArticle.astro";
import { SITE_CONFIG, SITE_TITLE, SITE_URL, SITE_PATHS, categoryLabel } from "../config";
import { liveArticles, formatDate } from "../lib/live";
import { withOrgAuthor, siteOrganization } from "../lib/schema";

type InstPage = "about" | "legal" | "privacy";

export async function getStaticPaths() {
  const reserved = new Set(Object.values(SITE_PATHS));
  const posts = liveArticles(await getCollection("articles")).filter((a) => !reserved.has(a.slug));
  const articles = posts.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
  const inst: { params: { slug: string }; props: { page: InstPage } }[] = [
    { params: { slug: SITE_PATHS.about }, props: { page: "about" } },
    { params: { slug: SITE_PATHS.legal }, props: { page: "legal" } },
    { params: { slug: SITE_PATHS.privacy }, props: { page: "privacy" } },
  ];
  return [...articles, ...inst];
}

interface Props {
  article?: CollectionEntry<"articles">;
  page?: InstPage;
}

const { article, page } = Astro.props as Props;
const org = siteOrganization(SITE_TITLE, SITE_URL);
const aboutSchema = {
  ...org,
  "@context": "https://schema.org",
  description: SITE_CONFIG.author.bio,
  email: SITE_CONFIG.contact_email,
};

let related: CollectionEntry<"articles">[] = [];
let recents: CollectionEntry<"articles">[] = [];
let schema: unknown = null;
let dateLabel = "";
let rubrique = "";
let Content: Awaited<ReturnType<NonNullable<typeof article>["render"]>>["Content"] | null = null;

if (article) {
  const rendered = await article.render();
  Content = rendered.Content;
  dateLabel = formatDate(article.data.date, SITE_CONFIG.locale);
  const others = liveArticles(await getCollection("articles")).filter((p) => p.slug !== article.slug);
  recents = others.slice(0, 5);
  const same = others.filter((p) => p.data.categorySlug === article.data.categorySlug);
  related = [...same, ...others.filter((p) => p.data.categorySlug !== article.data.categorySlug)].slice(0, 3);
  schema = withOrgAuthor(article.data.schemaJson, SITE_TITLE, SITE_URL, SITE_PATHS.about);
  rubrique = categoryLabel(article.data.categorySlug || article.data.category);
}

const layoutTitle = page === "about"
  ? `${SITE_CONFIG.ui.about} — ${SITE_TITLE}`
  : page === "legal"
    ? `${SITE_CONFIG.ui.legalNotice} — ${SITE_TITLE}`
    : page === "privacy"
      ? `${SITE_CONFIG.ui.privacyPolicy} — ${SITE_TITLE}`
      : (article?.data.metaTitle || article?.data.title || SITE_TITLE);

const layoutDescription = page === "about"
  ? SITE_CONFIG.author.bio
  : page === "legal"
    ? `Právní doložka webu ${SITE_TITLE}.`
    : page === "privacy"
      ? `Zásady nakládání s osobními údaji na webu ${SITE_TITLE}.`
      : article?.data.excerpt;
---

<Layout
  title={layoutTitle}
  description={layoutDescription}
  ogImage={article?.data.image}
  ogType={article ? "article" : "website"}
>
  {page === "about" && (
    <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(aboutSchema)} />
  )}
  {article && schema && (
    <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
  )}

  {page === "about" && (
    <div class="kf-feuille">
      <section class="kf-inst">
        <p class="kf-code">Metodika</p>
        <h1>{SITE_CONFIG.ui.about}</h1>
        <div class="kf-corps" set:html={SITE_CONFIG.aboutBody ?? ""} />
      </section>
    </div>
  )}

  {page === "legal" && (
    <div class="kf-feuille">
      <section class="kf-inst">
        <p class="kf-code">Právní doložka</p>
        <h1>{SITE_CONFIG.ui.legalNotice}</h1>
        <div class="kf-corps" set:html={SITE_CONFIG.legalBody ?? ""} />
      </section>
    </div>
  )}

  {page === "privacy" && (
    <div class="kf-feuille">
      <section class="kf-inst">
        <p class="kf-code">Soukromí</p>
        <h1>{SITE_CONFIG.ui.privacyPolicy}</h1>
        <div class="kf-corps" set:html={SITE_CONFIG.privacyBody ?? ""} />
      </section>
    </div>
  )}

  {article && Content && (
    <div class="kf-feuille">
      <article class="kf-article">
        <nav data-slot="fil" aria-label={SITE_CONFIG.ui.breadcrumbAria} class="kf-article__fil">
          <a href="/">{SITE_CONFIG.ui.home}</a>
          <span> / </span>
          <a href={`/category/${article.data.categorySlug}/`}>{rubrique}</a>
        </nav>
        <header>
          <p data-slot="kicker" class="kf-article__rubrique">{rubrique}</p>
          <h1 data-slot="titre" class="kf-article__titre">{article.data.title}</h1>
          <p data-slot="meta" class="kf-article__meta">
            <span>{SITE_CONFIG.ui.publishedBy}</span>
            <a href={`/${SITE_PATHS.about}/`}>{SITE_CONFIG.author.name}</a>
            <span class="kf-article__meta__sep">·</span>
            <time datetime={article.data.date.toISOString()}>{dateLabel}</time>
          </p>
        </header>

        <div data-slot="cover" class="kf-cover">
          {article.data.image && (
            <CoverImage
              src={article.data.image}
              alt={article.data.title}
              loading="eager"
              fetchpriority="high"
              width={1200}
              height={800}
            />
          )}
        </div>

        <div class="kf-article__grille">
          <div data-slot="corps" class="kf-corps">
            <Content />
          </div>

          <aside data-slot="latérale" class="kf-laterale" aria-label={SITE_CONFIG.ui.recentArticles}>
            <h2 class="kf-laterale__titre">{SITE_CONFIG.ui.recentArticles}</h2>
            <ul class="kf-laterale__liste">
              {recents.map((p) => (
                <li>
                  <a class="kf-laterale__lien" href={`/${p.slug}/`}>
                    <small>{categoryLabel(p.data.categorySlug)}</small>
                    <span>{p.data.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        </div>
      </article>

      <section data-slot="suite" class="kf-suite" aria-labelledby="suite-lecture">
        {related.length > 0 && (
          <>
            <h2 id="suite-lecture" class="kf-suite__titre">{SITE_CONFIG.ui.alsoRead}</h2>
            <div class="kf-grille">
              {related.map((p) => (
                <CarteArticle
                  href={`/${p.slug}/`}
                  title={p.data.title}
                  excerpt={p.data.excerpt}
                  image={p.data.image}
                  rubrique={categoryLabel(p.data.categorySlug || p.data.category)}
                  date={p.data.date}
                />
              ))}
            </div>
          </>
        )}
      </section>
    </div>
  )}
</Layout>
