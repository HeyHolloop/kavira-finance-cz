---
import "../styles/kavira.css";
import "../styles/article-blocks.css";
import TeteSite from "../components/TeteSite.astro";
import PiedSite from "../components/PiedSite.astro";
import { SITE_TITLE, SITE_URL, SITE_DESCRIPTION, SITE_CONFIG } from "../config";
import { siteOrganization } from "../lib/schema";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  ogTitle?: string;
  ogDescription?: string;
}

const {
  title,
  description = SITE_DESCRIPTION,
  ogImage = SITE_CONFIG.hero.image || "/images/accroche.jpg",
  ogType = "website",
  noindex = false,
  ogTitle,
  ogDescription,
} = Astro.props;

const lang = (SITE_CONFIG.locale || "cs-CZ").split("-")[0] || "cs";
const canonical = new URL(Astro.url.pathname, SITE_URL + "/").href;
const fullTitle = title.includes(SITE_TITLE) ? title : `${title} | ${SITE_TITLE}`;
const socialTitle = ogTitle || fullTitle;
const socialDescription = ogDescription || description;
const ogAbs = ogImage.startsWith("http") ? ogImage : `${SITE_URL}${ogImage}`;
const org = siteOrganization(SITE_TITLE, SITE_URL);
const structured = {
  "@context": "https://schema.org",
  "@graph": [
    {
      ...org,
      "@type": "NewsMediaOrganization",
      description: SITE_DESCRIPTION,
    },
    {
      "@type": "WebSite",
      "@id": `${SITE_URL}/#website`,
      url: SITE_URL + "/",
      name: SITE_TITLE,
      inLanguage: SITE_CONFIG.locale || "cs-CZ",
      publisher: { "@id": org["@id"] },
    },
  ],
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:image" content={ogAbs} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:locale" content={SITE_CONFIG.locale.replace("-", "_")} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={ogAbs} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structured)} />
    <slot name="head" />
  </head>
  <body>
    <a class="kf-saut" href="#main">{SITE_CONFIG.ui.skipToContent}</a>
    <TeteSite />
    <main id="main">
      <slot />
    </main>
    <PiedSite />
  </body>
</html>
